-- FM-shaped example: a private club per player and one shared match state.

struct Card {
	CardId: u16,
	Level: u8,
	Dupes: u8,
	Bonus: u8,
	Locked: boolean,
}

state Club {
	Scope: Player,
	Data: struct {
		Cash: f64,
		OfflinePending: f64,
		Tier: u8,
		KitColor: string,
		Style: string,
		Styles: map { [string]: boolean },
		Slots: string[],
		Stats: struct {
			Wins: u32, Draws: u32, Losses: u32, Goals: u32, Conceded: u32,
			Played: u32, PacksOpened: u32, Xp: u32, Streak: u16, BestStreak: u16,
		},
		Trophies: map { [string]: u16 },
		Pity: u16,
		Owned: map { [string]: Card },
	},
}

