-- Test schema: exercises every type and both mask forms (>32 fields).
enum Phase = { Lobby, Playing, Ended }

struct Item {
	Id: u16,
	Count: u8,
	Tag: string?,
}

state Big {
	Scope: Player,
	Data: struct {
		F1: u8,
		F2: u8,
		F3: u8,
		F4: u8,
		F5: u8,
		F6: u8,
		F7: u8,
		F8: u8,
		F9: u8,
		F10: u8,
		F11: u8,
		F12: u8,
		F13: u8,
		F14: u8,
		F15: u8,
		F16: u8,
		F17: u8,
		F18: u8,
		F19: u8,
		F20: u8,
		F21: u8,
		F22: u8,
		F23: u8,
		F24: u8,
		F25: u8,
		F26: u8,
		F27: u8,
		F28: u8,
		F29: u8,
		F30: u8,
		F31: u8,
		F32: u8,
		F33: u8,
		F34: u8,
		F35: u8,
		F36: u8,
		F37: u8,
		F38: u8,
		F39: u8,
		F40: u8,
		Name: string,
		Phase: Phase,
		Pos: vector?,
		Inv: map { [u16]: Item },
		Bag: Item[],
		Tags: string[],
		Extra: any,
		Opt: Item?,
		server Secret: string,
		server Log: map { [string]: u32 },
		Nested: map { [string]: map { [string]: i32 } },
		Huge: uint,
		Neg: int,
		Ratio: f32,
		Flag: boolean,
		Blob: buffer,
	},
}

state World {
	Scope: All,
	Data: struct {
		Round: u16,
		Phase: Phase,
		Scores: map { [string]: u32 },
	},
}

state Room {
	Scope: Manual,
	Data: struct {
		Name: string,
		Members: map { [string]: boolean },
	},
}

state Ranged {
	Scope: Manual,
	Data: struct {
		Level: u8(1..99),
		Ratio: f32(0..1),
		Nick: string(..12),
		Code: string(4),
		Team: u16(1..)[..3],
		Tags: map { [string(1..8)]: i8(-5..5) },
	},
}
